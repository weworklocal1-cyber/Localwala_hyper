{
  "name": "@localwala/auth-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OTP request/verify, sessions, token rotation, provider abstraction.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
