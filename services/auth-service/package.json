    "start": "node dist/src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@localwala/config": "*",
    "@localwala/contracts": "*",
    "@localwala/errors": "*",
    "@localwala/event-schemas": "*",
    "@localwala/logger": "*",
    "@localwala/validation": "*",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "zod": "^4.0.0"
  }
