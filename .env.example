# LocalWala — root environment template.
# Service-level variables live in services/<name>/.env.example.

NODE_ENV=development
LOG_LEVEL=info

# Infrastructure
POSTGRES_URL=postgresql://localwala:localwala@localhost:5432/localwala
MONGODB_URI=mongodb://localhost:27017/localwala
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Object storage / CDN (media-service) — mark BLOCKED until provider chosen
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMS OTP provider (auth-service) — mark BLOCKED until provider chosen
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Payment gateway (payment-service) — mark BLOCKED until provider chosen
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
